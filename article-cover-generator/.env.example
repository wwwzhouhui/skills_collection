# article-cover-generator 配置模板：复制为 .env，只填写要使用的模型对应密钥
# 注意：.env 含密钥，勿提交到任何仓库、勿截图分享（仓库 .gitignore 已排除）

# 默认模型：gpt-image-2.5（第三方中转站）
ARTICLE_COVER_MODEL=gpt-image-2.5
ARTICLE_COVER_API_BASE=https://image.mlgb7.com
ARTICLE_COVER_API_KEY=

# 可选模型：MiniMax/MiniMax-H3-Image（魔搭社区 ModelScope）
ARTICLE_COVER_MODELSCOPE_API_BASE=https://api-inference.modelscope.cn
ARTICLE_COVER_MODELSCOPE_API_KEY=

# 兼容技能目录 .env 的旧配置名：MODEL / API_BASE / API_KEY / MODELSCOPE_API_BASE / MODELSCOPE_API_KEY
# 为避免与其他程序环境变量碰撞，进程环境请使用 ARTICLE_COVER_*；同一服务的 BASE 与 KEY 必须同源。
