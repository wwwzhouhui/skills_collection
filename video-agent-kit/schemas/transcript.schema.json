{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-agent-kit/transcript",
  "title": "Transcript",
  "type": "object",
  "properties": {
    "provider": { "type": "string" },
    "time_unit": { "type": "string" },
    "text": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "speaker": { "type": "string" },
          "text": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "word": { "type": "string" },
          "text": { "type": "string" },
          "speaker": {}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
