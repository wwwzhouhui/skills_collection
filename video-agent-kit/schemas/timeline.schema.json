{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-agent-kit/timeline",
  "title": "Video Agent Timeline Project",
  "type": "object",
  "required": ["project", "assets", "tracks"],
  "anyOf": [
    { "required": ["sequence"] },
    { "required": ["output_canvas"] }
  ],
  "$defs": {
    "effect": {
      "type": "object",
      "anyOf": [
        { "required": ["type"] },
        { "required": ["name"] }
      ],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "params": { "type": "object" }
      },
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "anyOf": [
        { "required": ["type"] },
        { "required": ["name"] }
      ],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "params": { "type": "object" }
      },
      "additionalProperties": true
    },
    "clip_common": {
      "type": "object",
      "required": ["start", "reason"],
      "anyOf": [
        { "required": ["end"] },
        { "required": ["duration"] }
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "asset_id": { "type": "string" },
        "source": { "type": "string" },
        "input_path": { "type": "string" },
        "src": { "type": "string" },
        "text": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "timeline_start": { "type": "number", "minimum": 0 },
        "timeline_end": { "type": "number", "minimum": 0 },
        "position": { "type": "number", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 },
        "beat": { "type": "string" },
        "track_type": { "type": "string" },
        "volume": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "enabled": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "transition_in": { "$ref": "#/$defs/transition" },
        "transition_out": { "$ref": "#/$defs/transition" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        }
      },
      "additionalProperties": true
    },
    "clip": {
      "allOf": [
        { "$ref": "#/$defs/clip_common" },
        {
          "anyOf": [
            { "required": ["source"] },
            { "required": ["input_path"] },
            { "required": ["src"] }
          ]
        }
      ]
    },
    "track_clip": {
      "$comment": "Clips inside tracks[]. Non-video tracks may carry text instead of media source; runtime validation still requires source on video/main tracks.",
      "allOf": [
        { "$ref": "#/$defs/clip_common" },
        {
          "anyOf": [
            { "required": ["source"] },
            { "required": ["input_path"] },
            { "required": ["src"] },
            { "required": ["text"] }
          ]
        }
      ]
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 2 },
        "height": { "type": "integer", "minimum": 2 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "platform": { "type": "string" },
        "aspect_ratio": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "version": { "type": "string" },
    "task": { "type": "string" },
    "project": { "type": "object", "additionalProperties": true },
    "sequence": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "timebase": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "start_time": { "type": "number", "minimum": 0 },
        "canvas": { "$ref": "#/$defs/canvas" },
        "output_canvas": { "$ref": "#/$defs/canvas" }
      },
      "additionalProperties": true
    },
    "output_canvas": { "$ref": "#/$defs/canvas" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "source": { "type": "string" },
          "type": { "type": "string" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "fps": { "type": "number", "exclusiveMinimum": 0 },
          "metadata_path": { "type": "string" },
          "transcript_path": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/clip" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["clips"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "track_type": { "type": "string" },
          "order": { "type": "integer" },
          "muted": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "visible": { "type": "boolean" },
          "solo": { "type": "boolean" },
          "effects": {
            "type": "array",
            "items": { "$ref": "#/$defs/effect" }
          },
          "clips": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/track_clip" }
          }
        },
        "additionalProperties": true
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          { "required": ["time"] },
          { "required": ["start"] }
        ],
        "properties": {
          "time": { "type": "number", "minimum": 0 },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "label": { "type": "string" },
          "name": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/transition" },
          {
            "type": "object",
            "properties": {
              "at_clip": { "type": "integer", "minimum": 0 },
              "between": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 0 }
              }
            }
          }
        ]
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
