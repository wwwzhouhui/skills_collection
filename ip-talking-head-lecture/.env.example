# ===== 火山引擎 语音合成（豆包 TTS）=====
# 复制本文件为 .env 再填值（.env 已在 .gitignore，不会被提交）。
# 鉴权二选一：
#   新版控制台 -> API Key（ark- 开头的套餐 Key 只能走 plan 域）
VOLC_TTS_API_KEY=
#   旧版控制台 -> App ID + Access Token
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=

# 调用域：plan | standard。留空则按 Key 前缀自动判定（ark- → plan，其余 → standard）。
# ⚠️火山两个域互不相通，打错域报 `45000010 Invalid X-Api-Key`（不是额度不够）。
# ⚠️ark.cn-beijing.volces.com/api/plan/v3 是方舟另一套（非 TTS）入口，不要拿来当 TTS 的 baseURL。
VOLC_TTS_ENDPOINT=

# 资源 ID 与音色必须配套：
#   官方 2.0 音色（*_uranus_bigtts）  -> seed-tts-2.0     ← 推荐，有逐字时间戳，字幕最准
#   官方 1.0 音色（*_moon_bigtts 等）  -> seed-tts-1.0
#   声音复刻音色（S_ 开头）            -> volc.megatts.default
VOLC_TTS_RESOURCE_ID=seed-tts-2.0

# 音色 ID：火山「音色广场」复制。留空则用 config.json 的 tts.voice。
# 2.0 可用音色（已实测授权）见 references/voices-volc.md
VOLC_TTS_VOICE=zh_male_liufei_uranus_bigtts

# ===== 可选 =====
# 语速 / 音量：一般不用在这填，改 config.json 的 tts.speed / tts.loudness 更直观。
# VOLC_TTS_SPEED=20          # speech_rate，[-50,100]，20 = 1.2 倍速
# VOLC_TTS_LOUDNESS=0        # loudness_rate，[-50,100]，0 = 原音量
# VOLC_TTS_STYLE=            # 2.0 音色的自然语言风格，如「低沉沙哑的深夜电台女主播」，仅 *_uranus_bigtts 响应

# ===== 小米 MiMo 语音合成（mimo-v2.5-tts）=====
# 把 config.json 的 tts.engine 改成 "mi" 才走这条通道。凭证是 token-plan 的 tp- 开头 Key。
# 端点只有 {baseUrl}/chat/completions 一个入口（/audio/speech、/tts 都是 404）。
# ⚠️三条与火山不同的规矩（详见 references/voices-mi.md）：
#   1) 正文必须放在 messages 的 **assistant** 角色里（本仓库已实现），user 消息只当风格指令；
#   2) **没有语速参数**，config 的 tts.speed 由本地 ffmpeg atempo 后处理；
#   3) **不返回逐字时间戳**，句子级时间由静音检测估算，字幕后验精度略低于火山。
MI_TTS_API_KEY=
MI_TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MI_TTS_MODEL=mimo-v2.5-tts
# 音色只有九个：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
# 留空则用 config.json 的 tts.mi.voice
MI_TTS_VOICE=
# MI_TTS_STYLE=            # 自然语言风格指令，作为 user 消息一起发，如「语速偏快、语气轻松」
